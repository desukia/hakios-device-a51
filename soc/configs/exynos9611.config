# HakiOS fragment: the exynos9611 family -- what is true of the SoC, whatever device it is in.
#
# Read from the SM-A515F's device tree; NOT yet usable by the common kernel (see devices/a51/PORTING.md):
#   cores        8: 4x Cortex-A53 (MPIDR 0x000-0x003, cluster 0, boot cluster), 4x Cortex-A73 (MPIDR 0x100-0x103)
#   PSCI         method smc, CPU_ON 0xc4000003, CPU_OFF 0x84000002
#   GIC          GIC-400 (GICv2!) "arm,cortex-a15-gic": GICD 0x12301000, GICC 0x12302000, GICH 0x12304000, GICV 0x12306000
#                the common kernel has only gic_v3_irq.c (ICC_* system registers): a GICv2 driver is required
#   timer        arm,armv8-timer, 26 MHz (0x18cba80), PPIs 13/14/11/10, the device tree asks for the physical timer
#   UART         samsung,exynos-uart (not PL011), debug UART 0x13820000 (ttySAC0)
#   UFS          samsung,exynos-ufs @ 0x13520000 (not Qualcomm's UFS: HAKIOS_UFS does not apply)
#   USB          DWC3 @ 0x13200000
#   GPU          Mali-G72 MP3 @ 0x11500000 (not Adreno: HAKIOS_ADRENO / hakios-metal do not apply)
#   display      DECON-F @ 0x148b0000; S-Boot leaves a framebuffer at 0xca000000 (s3cfb.bootloaderfb)
#   PMIC         S2MPU09 (Samsung, not Qualcomm SPMI)
CONFIG_SOC="exynos9611"
